{
  "name": "components-library-mtx",
  "version": "1.2.1",
  "description": "A premium components library built with React, Tailwind CSS, and Framer Motion.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/Button.d.ts",
      "import": "./dist/components/Button.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./providers": {
      "types": "./dist/providers/LibraryProvider.d.ts",
      "import": "./dist/providers/LibraryProvider.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./api/routes": {
      "types": "./dist/api/routes/index.d.ts",
      "import": "./dist/api/routes/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./dal": {
      "types": "./dist/dal/index.d.ts",
      "import": "./dist/dal/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build:js": "tsdown",
    "build:css": "bunx @tailwindcss/cli -i ./src/index.css -o ./dist/index.css --minify",
    "build": "bun run build:js && bun run build:css",
    "release": "npm publish"
  },
  "dependencies": {
    "@elysia/eden": "^1.4.10",
    "@hookform/resolvers": "^5.2.2",
    "@sinclair/typebox": "^0.34.49",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elysia": "^1.4.28",
    "ky": "^2.0.2",
    "nuqs": "^2.8.9",
    "react-hook-form": "^7.75.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "next": ">=13.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@tanstack/react-query-devtools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/react": "^10.1.10",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "tsdown": "^0.18.3"
  },
  "engines": {
    "bun": "^1.3"
  },
  "license": "MIT",
  "author": "Metax"
}
