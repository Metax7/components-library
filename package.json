{
  "name": "components-library-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "release": "turbo run release --filter=components-library-mtx",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=better-wdpro",
    "test": "turbo run test",
    "storybook": "turbo run storybook --filter=storybook-app",
    "build-storybook": "turbo run build-storybook --filter=storybook-app",
    "chromatic": "turbo run chromatic --filter=storybook-app"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "engines": {
    "bun": "^1.3"
  },
  "version": "0.0.1"
}
